#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
START=50
# shellcheck disable=SC2034
STOP=20
# shellcheck disable=SC2034
USE_PROCD=1

console_instance() {
	. /usr/lib/udx-usb/gadget.sh
	[ -f "$UDX_RUN/applied" ] || return 0
	g_state_load "$UDX_RUN/applied" || return 1
	[ "$ACM" = 1 ] || return 0
	g_console_reason >/dev/null || return 0
	procd_open_instance console
	procd_set_param command /usr/libexec/udx-usb-console
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 3
	procd_close_instance
}

start_service() {
	# Host-only builds (CONFIG_USB_DWC3_HOST=y in config-7.3) expose no UDC,
	# so there is nothing to bind a gadget function to. The usbmgmt bridge and
	# its DHCP pool still come up: they are created by 90-udx-usb and served by
	# netifd/dnsmasq, and the Wi-Fi AP bridges into them. Skip the gadget part
	# quietly instead of failing the service on every boot.
	[ -e /sys/class/udc/29100000.usb ] || return 0
	/usr/libexec/udx-usb-gadget start || return $?
	console_instance
}

reload_service() {
	# Never turn an arbitrary UCI change or netifd event into USB re-enumeration.
	procd_open_service udx-usb /etc/init.d/udx-usb
	console_instance
	procd_close_service
}

status_service() {
	/usr/sbin/udx-usbctl status
}

stop_service() {
	[ -e /sys/class/udc/29100000.usb ] || return 0
	/usr/libexec/udx-usb-gadget stop
}
