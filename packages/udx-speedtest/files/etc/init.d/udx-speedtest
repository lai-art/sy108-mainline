#!/bin/sh /etc/rc.common
START=86
STOP=10
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/udx-speedtestd
	# Unlike udx-cellulard this daemon owns no AT port and no shared state: it
	# only reads wwan0 counters and runs curl, so a crash is safe to restart.
	# The kernel kills any orphaned curl with PR_SET_PDEATHSIG.
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 5
	procd_close_instance
}
stop_service() {
	# Ask the daemon to stop its task first: it kills curl and records the
	# reason, so a stop is never silent about consumed data.
	ubus -t 8 call udx.speedtest stop >/dev/null 2>&1 ||
		logger -p daemon.warn -t udx-speedtest 'No reply to stop; killing the service'
}
