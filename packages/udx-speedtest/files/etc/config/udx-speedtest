# udx-speedtest defaults and download targets.
# Used by /usr/sbin/udx-speedtestd (ubus object udx.speedtest).
# Node measurements and the "dead" flags come from
# docs/plans/测速功能方案.md §1.5.4 (2026-11-11, 3 MB range request).

config defaults 'defaults'
	option interface 'wwan0'
	option latency_target '223.5.5.5'
	option curl '/usr/bin/curl'
	option ping '/bin/ping'
	# Hottest thermal_zone above this value aborts a running task.
	option temperature_limit '70'
	option threads '4'
	# Speed test: stops at 20 s or 300 MB, whichever comes first. 300 MB over
	# 20 s is 120 Mbps, so above that the byte cap binds and the run ends early
	# (still valid, the last bucket is scaled by its real span). The cap is not
	# lower: 150 MB at 500 Mbps ends the run at 2.4 s, inside the 3 s
	# slow-start discard, leaving nothing to take a P90 of.
	# Clamped by the service to 10-30 s / 10-300 MB.
	option speed_seconds '20'
	option speed_bytes '300000000'
	# Traffic burner: user adjustable, clamped to 100 MB-10 GB / 30-1800 s.
	option burn_seconds '300'
	option burn_bytes '1000000000'

