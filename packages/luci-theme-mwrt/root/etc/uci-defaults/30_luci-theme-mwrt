#!/bin/sh

# Register and activate the Mwrt theme on a fresh install only.
# Upgrades (PKG_UPGRADE=1) skip the whole uci batch, so the theme the
# user picked is never overwritten on upgrade.
if [ "$PKG_UPGRADE" != 1 ]; then
	uci batch <<-EOF
		set luci.themes.Mwrt=/luci-static/mwrt
		set luci.main.mediaurlbase=/luci-static/mwrt
		set mwrt.theme.nav_type=sidebar
		set mwrt.theme.toolbar_enabled=0
		set mwrt.theme.logo_svg=logo.svg
		set mwrt.theme.favicon_ico=favicon.ico
		set mwrt.theme.pwa_apple_touch=apple-touch-icon.png
		set mwrt.theme.icon_cache_version=1
		commit luci
		commit mwrt
	EOF
fi

exit 0
