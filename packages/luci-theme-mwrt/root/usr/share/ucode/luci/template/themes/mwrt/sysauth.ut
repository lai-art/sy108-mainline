{#
 luci-theme-mwrt: login page
 Ported from mwrt argon theme sysauth.htm; inline styles and scripts are served as separate assets.
 Licensed under the Apache License 2.0.
-#}

{%
	import { readfile } from 'fs';
	const boardinfo = ubus.call('system', 'board') ?? {};

	/* 「关于」浮窗里默认信息一栏以前是写死的 mwrt 原厂值(192.168.66.1 / 20260909),
	   换到 SY108 后既不对、也不会随版本更新。这里改成读镜像里的真实文件:
	   - /etc/udx-system-build 由 packages/udx-runtime/Makefile 打包时写入
	     (git describe --always --dirty, 例: sy108-v2026.11.19-6-gf1a6253)
	   - /etc/os-release 的 OPENWRT_BUILD_DATE 是 OpenWrt 构建时写下的 Unix 时间戳 */
	const _stamp = trim(readfile('/etc/udx-system-build') ?? '') || '--';
	const _osr = readfile('/etc/os-release') ?? '';
	const _bd = match(_osr, /OPENWRT_BUILD_DATE="?([0-9]+)/);
	let _bdate = '--';
	if (_bd != null) {
		const _t = localtime(+_bd[1]);
		_bdate = sprintf('%04d-%02d-%02d %02d:%02d', _t.year, _t.mon, _t.mday, _t.hour, _t.min);
	}
-%}
{% include('header', {
	blank_page: true,
	prefetched_boardinfo: boardinfo
}) %}

<div class="al" id="al" data-err="{{ fuser ? '1' : '0' }}">
  <!-- 右上角日夜切换:与后台共用 localStorage mwrt-theme -->
  <button class="al-tg" id="alTg" type="button" aria-label="切换到夜间模式" title="切换日夜模式">
    <svg class="al-ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    <svg class="al-ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"/></svg>
  </button>
  <!-- 背景远山剪影:纯装饰 -->
  <div class="al-bgd" aria-hidden="true">
    <svg viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path d="M0 320V196L150 118L262 188L430 56L612 206L742 138L918 230L1092 102L1252 196L1440 126V320Z" fill="rgb(120 170 245 / .20)"/>
      <path d="M0 320V246L214 160L382 240L566 142L742 252L936 184L1124 258L1300 172L1440 232V320Z" fill="rgb(86 150 255 / .24)"/>
      <path d="M0 320V284L262 220L462 284L700 208L922 290L1160 232L1440 290V320Z" fill="rgb(47 125 225 / .26)"/>
    </svg>
  </div>
  <div class="al-wrap">
    <!-- 四个卡通角色:纯装饰,站在卡片上沿。眼睛跟随指针/触点,输入账号时紫黑对视,输入密码时侧身,显示密码时紫色那只偷看 -->
    <div class="al-slot" id="alSlot" aria-hidden="true">
      <div class="al-box" id="alBox">
        <div class="al-stage" id="alStage">
          <div class="al-ch al-pu" id="alPu">
            <div class="al-face" id="alPuF">
              <div class="al-eyeball al-eb18" data-who="pu" data-max="5"><div class="al-ep"></div></div>
              <div class="al-eyeball al-eb18" data-who="pu" data-max="5"><div class="al-ep"></div></div>
            </div>
          </div>
          <div class="al-ch al-bl" id="alBl">
            <div class="al-face" id="alBlF">
              <div class="al-eyeball al-eb16" data-who="bl" data-max="4"><div class="al-ep"></div></div>
              <div class="al-eyeball al-eb16" data-who="bl" data-max="4"><div class="al-ep"></div></div>
            </div>
          </div>
          <div class="al-ch al-or" id="alOr">
            <div class="al-face" id="alOrF">
              <div class="al-dot" data-who="or" data-max="5"></div>
              <div class="al-dot" data-who="or" data-max="5"></div>
            </div>
          </div>
          <div class="al-ch al-ye" id="alYe">
            <div class="al-face" id="alYeF">
              <div class="al-dot" data-who="ye" data-max="5"></div>
              <div class="al-dot" data-who="ye" data-max="5"></div>
            </div>
            <div class="al-mouth" id="alYeM"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="al-card" id="alCard">
      <div class="al-head">
        <div class="al-brand">
          <span class="al-logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></span>
          <span class="al-bn">Mr_ ⒈个人╜り</span>
        </div>
        <h1 class="al-title">{{ _('登录到管理后台') }}</h1>
        <p class="al-sub">{{ _('路由器管理系统') }}</p>
      </div>
      {% if (fuser): %}
      <div class="al-err" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>{{ _('用户名或密码错误，请重试') }}</span>
      </div>
      {% endif %}
      <form method="post" id="alForm">
        <div class="al-field">
          <label class="al-label" for="al-user">{{ _('用户名') }}</label>
          <div class="al-inp">
            <svg class="al-pre" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <input class="al-in" type="text" id="al-user" name="luci_username" value="{{ entityencode(duser ?? '', true) }}" placeholder="请输入管理员账号" autocomplete="username" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="next" />
          </div>
        </div>
        <div class="al-field">
          <label class="al-label" for="al-pass">{{ _('密码') }}</label>
          <div class="al-inp">
            <svg class="al-pre" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input class="al-in al-pw" type="password" id="al-pass" name="luci_password" placeholder="请输入密码" autocomplete="current-password" enterkeyhint="go" />
            <button class="al-eye" type="button" id="alEye" aria-label="显示密码" aria-pressed="false">
              <svg class="al-eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="al-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.1 10.1 0 0 1 12 19c-6.4 0-10-7-10-7a18.5 18.5 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.1 9.1 0 0 1 12 4c6.4 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
            </button>
          </div>
        </div>
        <button class="al-btn" type="submit" id="alBtn"><span class="al-spin" aria-hidden="true"></span><span id="alBtnT">{{ _('登录') }}</span></button>
      </form>
      <div class="al-foot">
        <div class="al-fw-m">{{ _('固件版本') }} {{ entityencode(version?.distname ?? '', true) }}</div>
        <button class="al-about" type="button" onclick="abOpen()" aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>{{ _('关于免责声明') }}
        </button>
        <div class="al-ft-line"><span class="al-ft-b">{{ _('欢迎使用') }}</span></div>
      </div>
    </div>
  </div>
</div>

<div class="ab-mask" id="abMask" role="dialog" aria-modal="true" aria-labelledby="abTitle">
  <div class="ab-box">
    <div class="ab-hd">
      <div class="ab-hd-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
      </div>
      <div class="ab-hd-txt">
        <h3 id="abTitle">{{ _('关于 Mwrt') }}</h3>
        <div class="ab-hd-sub">Router Management System</div>
      </div>
      <button class="ab-x" type="button" onclick="abClose()" aria-label="关闭">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="ab-tabs">
      <button class="ab-tab on" type="button" data-ab-tab="info">{{ _('系统介绍') }}</button>
      <button class="ab-tab" type="button" data-ab-tab="law">{{ _('免责声明') }}</button>
    </div>
    <div class="ab-bd">
      <div class="ab-pane on" data-ab-pane="info">
        <p><b>Mwrt</b> 是基于 ImmortalWrt / OpenWrt 构建的路由器管理系统,面向本设备做了针对性适配,整合了路由切换、蜂窝管理、USB加速等优化。</p>
        <div class="ab-sec">{{ _('设备信息') }}</div>
        <table class="ab-kv">
          <tr><td>设备型号</td><td>{{ entityencode(boardinfo?.model ?? '', true) }}</td></tr>
          <tr><td>主控平台</td><td>{{ entityencode(boardinfo?.system ?? '', true) }}</td></tr>
          <tr><td>无线规格</td><td>—</td></tr>
          <tr><td>有线接口</td><td>—</td></tr>
          <tr><td>固件版本</td><td>{{ entityencode(_stamp, true) }}</td></tr>
          <tr><td>系统基线</td><td>{{ entityencode(boardinfo?.release?.target ?? '', true) }}</td></tr>
        </table>
        <div class="ab-sec">{{ _('主要功能') }}</div>
        <p>
          · <b>5G 模组管理</b>:巴龙模组短信PDU\TXT短信适配,webui与模组基本功能<br/>
          · <b>网络服务</b>:路由器保活功能，自动切换5G与有线网处理<br/>
          · <b>加速服务</b>:USB虚拟网卡硬件加速服务，媲美PCIE直通性能<br/>
          · <b>系统维护</b>:预留PWM温控软/硬驱动，软件PWM可适配一切风扇
        </p>
        <div class="ab-sec">{{ _('默认信息') }}</div>
        <table class="ab-kv">
          <tr><td>管理地址</td><td>192.168.9.1</td></tr>
          <tr><td>默认账号</td><td>root</td></tr>
          <tr><td>构建时间</td><td>{{ entityencode(_bdate, true) }}</td></tr>
        </table>
      </div>
      <div class="ab-pane" data-ab-pane="law">
        <p>本固件为第三方定制固件,由社区维护,<b>仅供个人学习、研究与测试使用</b>,不随设备销售,也不构成任何形式的商业承诺。</p>
        <p>固件按“现状”提供,不附带任何明示或暗示的担保。作者与分发者<b>不对因使用本固件而导致的任何后果负责</b>,包括但不限于:设备无法启动或变砖、数据丢失、网络中断、硬件损坏,以及由此产生的直接或间接损失。</p>
        <p>刷写、修改配置或启用第三方插件均由您<b>自行承担风险</b>。操作前请务必备份原厂固件与重要数据,并确认您有权对该设备进行修改。</p>
        <p>请遵守所在国家和地区的法律法规。<b>严禁将本固件用于任何违法用途</b>;因违规使用产生的一切责任由使用者自行承担。</p>
        <p>继续使用即表示您已阅读、理解并接受以上全部条款。若不同意,请立即停止使用并刷回官方固件。</p>
      </div>
    </div>
    <div class="ab-ft">{{ _('欢迎使用') }}</div>
  </div>
</div>

<script defer src="{{ media }}/mwrt-login.js?v={{ asset_version }}"></script>

{% include('footer', { blank_page: true }) %}
