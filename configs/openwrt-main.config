CONFIG_TARGET_sprd=y
CONFIG_TARGET_sprd_udx710=y
CONFIG_TARGET_sprd_udx710_DEVICE_sy108=y
CONFIG_DEVEL=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=64
CONFIG_TARGET_SQUASHFS_COMP_XZ=y
CONFIG_BUILD_LOG=y
CONFIG_PACKAGE_udx-runtime=y
CONFIG_PACKAGE_udx-cpnv=y
CONFIG_PACKAGE_udx-cellular=y
CONFIG_PACKAGE_udx-device=y
CONFIG_PACKAGE_udx-usb=y
CONFIG_PACKAGE_udx-upgrade=y
CONFIG_PACKAGE_udx-speedtest=y
CONFIG_PACKAGE_luci-app-udx=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-outline=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_flock=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TASKSET=y
CONFIG_BUSYBOX_CONFIG_LOGIN=y
CONFIG_BUSYBOX_CONFIG_CHPASSWD=y
# The status.latency prober and the speed test's load-latency sampling both
# shell out to ping(1). It defaults to y in busybox, but BUSYBOX_CUSTOM is on
# here, so state it: trimming applets later must not silently break latency.
CONFIG_BUSYBOX_CONFIG_PING=y
# CONFIG_SY108_RECOVERY is not set
CONFIG_PACKAGE_python3=y
CONFIG_KERNEL_DEVTMPFS=y
CONFIG_KERNEL_DEVTMPFS_MOUNT=y
CONFIG_KERNEL_PROC_PAGE_MONITOR=y
CONFIG_KERNEL_SQUASHFS_XATTR=y
CONFIG_KERNEL_BLK_DEV_BSG=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_ARM_PMUV3=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_usbutils=y
# External USB Wi-Fi AP: BL-M7921AU1 (MediaTek MT7921AUN, USB 0e8d:7961).
# The driver itself is built into the kernel (CONFIG_MT7921U=y in config-7.3);
# these are only the user-space pieces.
#   wifi-scripts  turns /etc/board.json wlan.defaults into /etc/config/wireless
#                 and is also what `wifi config/up` drive (24.10+ replaces the
#                 old mac80211.sh)
#   wpad-mbedtls  provides both hostapd (AP) and wpa_supplicant (STA)
#   iw            nl80211 tool that iwinfo and wifi-scripts call
# There is deliberately no luci-proto-wireless: LuCI's protocols/ directory has
# no such package (verified against the pinned luci tree). wlan devices and
# wifi-ifaces are edited by luci-mod-network, which is already selected above.
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_iw=y
# mt76 gates its Kconfig on these: kmod-mt76-default wants DRIVER_11AC_SUPPORT
# and KERNEL_PAGE_POOL, the MT792x family additionally wants DRIVER_11AX_SUPPORT.
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
CONFIG_KERNEL_PAGE_POOL=y
# The firmware and the regulatory database are embedded in the kernel through
# CONFIG_EXTRA_FIRMWARE, so the packaged copies would only add a second, unused
# copy to the rootfs - and on this board they would be requested too late.
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_kmod-mt7921-firmware is not set
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="sy108"
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_kmod-ppp is not set
# CONFIG_PACKAGE_kmod-pppox is not set
# CONFIG_PACKAGE_kmod-pppoe is not set
# CONFIG_PACKAGE_linux-atm is not set
CONFIG_PACKAGE_luci-app-sy108-system=y
# CONFIG_PACKAGE_ucert is not set
# CONFIG_PACKAGE_ucert-full is not set
CONFIG_PACKAGE_fwtool=y
CONFIG_BUSYBOX_CONFIG_FLOAT_DURATION=y
