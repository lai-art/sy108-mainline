@@ -20,6 +20,9 @@
 }
 
 start_service() {
+	# Host-only builds have no UDC; keep the management bridge but do not
+	# attempt gadget setup.
+	[ -e /sys/class/udc/29100000.usb ] || return 0
 	/usr/libexec/udx-usb-gadget start || return $?
 	console_instance
 }
