+diff --git a/drivers/staging/sprd/sipa/sipa_wifi.c b/drivers/staging/sprd/sipa/sipa_wifi.c
+new file mode 100755
+index 000000000..2bfd87878
+--- /dev/null
++++ b/drivers/staging/sprd/sipa/sipa_wifi.c
+@@ -0,0 +1,176 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * SY108 SIPA WLAN software NIC.
++ *
++ * This is not a PAMU3 or WCN DMA path.  It exposes SIPA_TERM_WIFI as an
++ * Ethernet netdev so a host USB Wi-Fi AP can feed SIPA through the existing
++ * sipa_nic software endpoint.
++ */
++#include <linux/etherdevice.h>
++#include <linux/init.h>
++#include <linux/interrupt.h>
++#include <linux/module.h>
++#include <linux/netdevice.h>
++#include <linux/skbuff.h>
++#include <linux/sipa.h>
++
++struct sipa_wifi_priv {
++	struct net_device *ndev;
++	struct napi_struct napi;
++	enum sipa_nic_id nic;
++	bool nic_open;
++};
++
++static void sipa_wifi_rx_cb(void *priv, enum sipa_evt_type evt,
++			    unsigned long err)
++{
++	struct sipa_wifi_priv *p = priv;
++
++	(void)err;
++	switch (evt) {
++	case SIPA_RECEIVE:
++		napi_schedule(&p->napi);
++		break;
++	case SIPA_LEAVE_FLOWCTRL:
++		if (netif_running(p->ndev))
++			netif_wake_queue(p->ndev);
++		break;
++	default:
++		break;
++	}
++}
++
++static int sipa_wifi_poll(struct napi_struct *napi, int budget)
++{
++	struct sipa_wifi_priv *p = container_of(napi, struct sipa_wifi_priv,
++						 napi);
++	struct net_device *ndev = p->ndev;
++	int work = 0;
++
++	while (work < budget) {
++		struct sk_buff *skb = NULL;
++		int ret;
++
++		ret = sipa_nic_rx(p->nic, &skb);
++		if (ret) {
++			if (ret != -ENODATA && ret != -ENODEV)
++				ndev->stats.rx_errors++;
++			break;
++		}
++		if (!skb)
++			break;
++
++		skb->dev = ndev;
++		skb->protocol = eth_type_trans(skb, ndev);
++		ndev->stats.rx_packets++;
++		ndev->stats.rx_bytes += skb->len;
++		netif_receive_skb(skb);
++		work++;
++	}
++
++	if (work < budget)
++		napi_complete_done(napi, work);
++	else
++		napi_schedule(napi);
++
++	return work;
++}
++
++static netdev_tx_t sipa_wifi_xmit(struct sk_buff *skb, struct net_device *ndev)
++{
++	struct sipa_wifi_priv *p = netdev_priv(ndev);
++	int ret;
++
++	if (!READ_ONCE(p->nic_open)) {
++		dev_kfree_skb_any(skb);
++		ndev->stats.tx_dropped++;
++		return NETDEV_TX_OK;
++	}
++
++	ret = sipa_nic_tx(p->nic, SIPA_TERM_WIFI, -1, skb);
++	if (ret == -EAGAIN || ret == -EINPROGRESS) {
++		/* SIPA did not take this skb.  Keep it for the caller. */
++		netif_stop_queue(ndev);
++		return NETDEV_TX_BUSY;
++	}
++	if (ret) {
++		dev_kfree_skb_any(skb);
++		ndev->stats.tx_errors++;
++		return NETDEV_TX_OK;
++	}
++
++	ndev->stats.tx_packets++;
++	ndev->stats.tx_bytes += skb->len;
++	return NETDEV_TX_OK;
++}
++
++static int sipa_wifi_open(struct net_device *ndev)
++{
++	struct sipa_wifi_priv *p = netdev_priv(ndev);
++	int ret;
++
++	if (READ_ONCE(p->nic_open))
++		return 0;
++
++	ret = sipa_nic_open(SIPA_TERM_WIFI, -1, sipa_wifi_rx_cb, p);
++	if (ret < 0)
++		return ret;
++
++	p->nic = ret;
++	WRITE_ONCE(p->nic_open, true);
++	napi_enable(&p->napi);
++	netif_start_queue(ndev);
++	return 0;
++}
++
++static int sipa_wifi_stop(struct net_device *ndev)
++{
++	struct sipa_wifi_priv *p = netdev_priv(ndev);
++
++	netif_stop_queue(ndev);
++	napi_disable(&p->napi);
++	if (READ_ONCE(p->nic_open)) {
++		WRITE_ONCE(p->nic_open, false);
++		sipa_nic_close(p->nic);
++	}
++	return 0;
++}
++
++static const struct net_device_ops sipa_wifi_netdev_ops = {
++	.ndo_open	= sipa_wifi_open,
++	.ndo_stop	= sipa_wifi_stop,
++	.ndo_start_xmit	= sipa_wifi_xmit,
++};
++
++static int __init sipa_wifi_init(void)
++{
++	struct net_device *ndev;
++	struct sipa_wifi_priv *p;
++	int ret;
++
++	ndev = alloc_netdev(sizeof(*p), "sipa%d", NET_NAME_ENUM, ether_setup);
++	if (!ndev)
++		return -ENOMEM;
++
++	p = netdev_priv(ndev);
++	p->ndev = ndev;
++	p->nic = SIPA_NIC_WIFI;
++
++	ndev->netdev_ops = &sipa_wifi_netdev_ops;
++	eth_hw_addr_random(ndev);
++	netif_napi_add(ndev, &p->napi, sipa_wifi_poll);
++
++	ret = register_netdev(ndev);
++	if (ret) {
++		netif_napi_del(&p->napi);
++		free_netdev(ndev);
++		return ret;
++	}
++
++	pr_info("sipa_wifi: registered %s\n", ndev->name);
++	return 0;
++}
++late_initcall(sipa_wifi_init);
++
++MODULE_DESCRIPTION("SY108 SIPA WLAN software NIC");
++MODULE_LICENSE("GPL");
