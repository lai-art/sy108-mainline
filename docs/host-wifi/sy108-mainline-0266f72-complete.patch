--- /dev/null
+++ b/packages/udx-runtime/files/etc/hotplug.d/net/20-usb-lan
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Attach newly appeared USB Ethernet ports to the usbmgmt LAN bridge.
+# This only changes bridge membership; it does not touch UCI or reload network.
+[ "$ACTION" = "add" ] || exit 0
+
+case "$INTERFACE" in
+	lo|br-*|wlan*|wwan*|uncm*)
+		exit 0
+		;;
+esac
+
+[ -e "/sys/class/net/$INTERFACE/device" ] || exit 0
+[ -e "/sys/class/net/$INTERFACE/phy80211" ] && exit 0
+readlink -f "/sys/class/net/$INTERFACE/device" | grep -q '/usb' || exit 0
+[ -d /sys/class/net/br-usb/bridge ] || exit 0
+
+ip link set dev "$INTERFACE" master br-usb 2>/dev/null || true
+exit 0
diff --git a/packages/udx-runtime/files/etc/init.d/usb-lan b/packages/udx-runtime/files/etc/init.d/usb-lan
new file mode 100755
index 0000000000000000000000000000000000000000..c653c8887a3604b8c5d26da8560cda47ab128ec7
--- /dev/null
+++ b/packages/udx-runtime/files/etc/init.d/usb-lan
@@ -0,0 +1,28 @@
+#!/bin/sh /etc/rc.common
+
+START=99
+STOP=10
+
+start() {
+	[ -d /sys/class/net/br-usb/bridge ] || return 0
+
+	for path in /sys/class/net/*; do
+		ifname=${path##*/}
+
+		case "$ifname" in
+			lo|br-*|wlan*|wwan*|uncm*)
+				continue
+				;;
+		esac
+
+		[ -e "$path/device" ] || continue
+		[ -e "$path/phy80211" ] && continue
+		readlink -f "$path/device" | grep -q '/usb' || continue
+
+		ip link set dev "$ifname" master br-usb 2>/dev/null || true
+	done
+}
+
+boot() {
+	start
+}
