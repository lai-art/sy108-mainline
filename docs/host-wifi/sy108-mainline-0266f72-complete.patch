diff --git a/scripts/target/pamu3-host-dma-probe.sh b/scripts/target/pamu3-host-dma-probe.sh
new file mode 100755
index 0000000000000000000000000000000000000000..b7bfb997db476baf2dcd91e4ad98931ee060aa86
--- /dev/null
+++ b/scripts/target/pamu3-host-dma-probe.sh
@@ -0,0 +1,74 @@
+#!/bin/sh
+# Detect whether the PAMU3 block could possibly act as a host DMA engine.
+# Read-only: no PAM_EN/USB_EN writes, no DMA, no DWC3 mode change.
+set -u
+
+PAM_BASE="${PAM_BASE:-0x2b300000}"
+PAM_CTL0=0x0
+
+echo '=== device tree ==='
+for p in \
+	/proc/device-tree/soc/ipa-bus/pamu3@2b300000 \
+	/proc/device-tree/soc/ipa-bus/pamu3@2b300000/status \
+	/proc/device-tree/soc/ipa-bus/usb3@21400000 \
+	/proc/device-tree/soc/ipa-bus/usb3@21400000/usb@21400000; do
+	[ -e "$p" ] && echo "present: $p"
+done
+
+if [ -f /proc/device-tree/soc/ipa-bus/pamu3@2b300000/status ]; then
+	echo -n 'pamu3 status: '
+	tr -d '\000' < /proc/device-tree/soc/ipa-bus/pamu3@2b300000/status
+	echo
+fi
+
+echo '=== DWC3 role and PAMU3 property ==='
+find /proc/device-tree -name dr_mode 2>/dev/null | while read -r f; do
+	echo -n "$f: "
+	tr -d '\000' < "$f"
+	echo
+done
+
+find /proc/device-tree -name '*pamu3*' 2>/dev/null | while read -r f; do
+	echo "pamu3 node: $f"
+done
+
+# The property is a boolean; print its path if present.
+if find /proc/device-tree -type f -name 'sprd,pamu3-offload' 2>/dev/null | grep -q .; then
+	echo 'sprd,pamu3-offload: present'
+else
+	echo 'sprd,pamu3-offload: absent'
+fi
+
+echo '=== drivers / UDC ==='
+ls -l /sys/bus/platform/drivers/sprd-pamu3 2>/dev/null || echo 'sprd-pamu3 driver: not bound/absent'
+if [ -d /sys/class/udc ] && [ -n "$(ls -A /sys/class/udc 2>/dev/null)" ]; then
+	echo 'UDC:'
+	ls /sys/class/udc
+else
+	echo 'UDC: none (host-only or gadget not registered)'
+fi
+
+echo '=== dmesg ==='
+dmesg 2>/dev/null | grep -i -E 'pamu3|dwc3|sipa' | tail -80
+
+echo '=== PAMU3 CTL0 ==='
+if command -v devmem >/dev/null 2>&1 && [ -e /dev/mem ]; then
+	raw=$(devmem "$PAM_BASE" 32 2>/dev/null || true)
+	echo "PAM_U3_CTL0 @ $PAM_BASE = ${raw:-read-failed}"
+	case "$raw" in
+	0x*|0X*)
+		v=$((raw))
+		[ $((v & 0x2)) -ne 0 ] && echo 'PAM_EN=1' || echo 'PAM_EN=0'
+		[ $((v & 0x1)) -ne 0 ] && echo 'USB_EN=1' || echo 'USB_EN=0'
+		;;
+	esac
+else
+	echo 'devmem or /dev/mem unavailable; use the driver-state evidence above'
+fi
+
+echo
+echo '=== interpretation ==='
+echo 'PAMU3 is a DWC3 gadget endpoint accelerator. If dr_mode=host,'
+echo 'sprd,pamu3-offload is absent, and no UDC exists, PAMU3 cannot'
+echo 'parse xHCI host TRBs/URBs. A non-running PAM_EN/USB_EN confirms'
+echo 'there is no active PAM DMA path to hijack for Host WiFi.'
diff --git a/scripts/target/sipa-flowtable-test.sh b/scripts/target/sipa-flowtable-test.sh
new file mode 100755
index 0000000000000000000000000000000000000000..a67abfed9ee612b52ef1b0534ca0502f5c49ab44
--- /dev/null
+++ b/scripts/target/sipa-flowtable-test.sh
@@ -0,0 +1,67 @@
+#!/bin/sh
+# Run on SY108 after booting the SIPA-flowtable build.
+# Leaves a temporary nft table named sy108_ft; remove with:
+#   nft delete table inet sy108_ft
+set -u
+
+TABLE=sy108_ft
+
+for cmd in nft ip; do
+	command -v "$cmd" >/dev/null 2>&1 || {
+		echo "missing $cmd" >&2
+		exit 1
+	}
+done
+
+for dev in wwan0 br-usb; do
+	ip link show "$dev" >/dev/null 2>&1 || {
+		echo "missing netdev $dev" >&2
+		exit 1
+	}
+done
+
+nft delete table inet "$TABLE" 2>/dev/null || true
+
+nft add table inet "$TABLE" || exit 1
+
+echo '--- create offloaded flowtable with wan + wifi bridge ---'
+if ! nft add flowtable inet "$TABLE" ft \
+	'{ hook ingress priority 0; devices = { wwan0, br-usb }; flags offload; }'; then
+	echo 'flowtable with br-usb + flags offload rejected' >&2
+	echo '--- retry with wwan0 only ---'
+	if ! nft add flowtable inet "$TABLE" ft \
+		'{ hook ingress priority 0; devices = { wwan0 }; flags offload; }'; then
+		echo 'flowtable with wwan0 + flags offload rejected' >&2
+		echo '--- retry without flags offload (software only) ---'
+		nft add flowtable inet "$TABLE" ft \
+			'{ hook ingress priority 0; devices = { wwan0, br-usb }; }' || exit 1
+	fi
+fi
+
+nft add chain inet "$TABLE" forward \
+	'{ type filter hook forward priority 0; policy accept; }' || exit 1
+
+echo '--- add flow offload rules ---'
+if ! nft add rule inet "$TABLE" forward ip protocol tcp flow add @ft; then
+	echo 'TCP flow rule rejected' >&2
+fi
+if ! nft add rule inet "$TABLE" forward ip protocol udp flow add @ft; then
+	echo 'UDP flow rule rejected' >&2
+fi
+
+echo '--- nft table ---'
+nft list table inet "$TABLE" || true
+
+echo '--- flowtables ---'
+nft list flowtables || true
+
+echo '--- recent SIPA messages ---'
+dmesg | tail -80
+
+echo
+echo 'Traffic test: from a WiFi client, run TCP/UDP through the WAN, then:'
+echo '  nft list flowtables'
+echo '  nft list table inet sy108_ft'
+echo '  cat /proc/interrupts | grep -i sipa'
+echo '  top -d 1'
+echo 'Cleanup: nft delete table inet sy108_ft'
diff --git a/scripts/target/sipa-wifi-probe.sh b/scripts/target/sipa-wifi-probe.sh
