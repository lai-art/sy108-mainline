@@ -0,0 +1,21 @@
+#!/bin/sh
+# Probe SIPA WLAN endpoint availability before writing sipa_wifi.
+set -u
+
+echo '--- SIPA endpoint creation ---'
+dmesg | grep -E 'create sipa eps|ep_id|SIPA_EP|wifi' | tail -120
+
+echo '--- SIPA debugfs ---'
+for d in /sys/kernel/debug/sipa* /sys/kernel/debug/2e000000.ipa; do
+	[ -d "$d" ] && {
+		echo "## $d"
+		ls -l "$d"
+	}
+done
+
+echo '--- netdevs ---'
+ip -d link show
+
+echo '--- SIPA modules/config ---'
+zcat /proc/config.gz 2>/dev/null | grep -E 'SPRD_SIPA|WCN|NF_FLOW' || \
+	grep -E 'SPRD_SIPA|WCN|NF_FLOW' /boot/config-* 2>/dev/null || true
