@@ -0,0 +1,28 @@
+#!/bin/sh /etc/rc.common
+
+START=99
+STOP=10
+
+start() {
+	[ -d /sys/class/net/br-usb/bridge ] || return 0
+
+	for path in /sys/class/net/*; do
+		ifname=${path##*/}
+
+		case "$ifname" in
+			lo|br-*|wlan*|wwan*|uncm*)
+				continue
+				;;
+		esac
+
+		[ -e "$path/device" ] || continue
+		[ -e "$path/phy80211" ] && continue
+		readlink -f "$path/device" | grep -q '/usb' || continue
+
+		ip link set dev "$ifname" master br-usb 2>/dev/null || true
+	done
+}
+
+boot() {
+	start
+}
