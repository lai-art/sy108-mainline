+#!/bin/sh
+# Attach newly appeared USB Ethernet ports to the usbmgmt LAN bridge.
+# This only changes bridge membership; it does not touch UCI or reload network.
+[ "$ACTION" = "add" ] || exit 0
+
+case "$INTERFACE" in
+	lo|br-*|wlan*|wwan*|uncm*)
+		exit 0
+		;;
+esac
+
+[ -e "/sys/class/net/$INTERFACE/device" ] || exit 0
+[ -e "/sys/class/net/$INTERFACE/phy80211" ] && exit 0
+readlink -f "/sys/class/net/$INTERFACE/device" | grep -q '/usb' || exit 0
+[ -d /sys/class/net/br-usb/bridge ] || exit 0
+
+ip link set dev "$INTERFACE" master br-usb 2>/dev/null || true
+exit 0
